# Server Configuration
ADMIN_PASSWORD=
BODY_SIZE_LIMIT=
CORS_ORIGINS=
MAIN_DOMAIN=
TRUST_PROXY=
COOKIE_SECURE=

# Database (optional PostgreSQL connection; falls back to embedded SQLite/in-memory if unset)
DATABASE_URL=

# AI Features (Google Gemini API)
GEMINI_API_KEY=

# Payment Gateway (Zibal - Official Gateway & Fixed IP Relay)
# 1. ZIBAL_MERCHANT: Your merchant ID from Zibal dashboard (use 'zibal' for testing/sandbox).
ZIBAL_MERCHANT=zibal

# 2. ZIBAL_PROXY_URL / ZIBAL_FIXED_IP_URL: (CRITICAL for production whitelisted IP)
# URL of your fixed-IP reverse proxy / relay server (e.g., https://relay.yourdomain.ir or http://185.x.x.x:8080)
# When set, backend calls to /v1/request and /v1/verify route through this fixed static IP.
# If unset, calls go directly to https://gateway.zibal.ir.
ZIBAL_PROXY_URL=

# 3. ZIBAL_PROXY_TOKEN: (Optional) Secret key to authenticate requests with your fixed-IP relay server
ZIBAL_PROXY_TOKEN=

# 4. ZIBAL_CALLBACK_URL: (Optional) Explicit callback URL. If unset, automatically uses https://<host>/api/payment/zibal/callback
ZIBAL_CALLBACK_URL=

# 5. ZIBAL_GATEWAY_URL: Public URL where customer is redirected to pay (default: https://gateway.zibal.ir)
ZIBAL_GATEWAY_URL=https://gateway.zibal.ir

# 6. ZIBAL_MODE: 'production' or 'sandbox'
ZIBAL_MODE=production

